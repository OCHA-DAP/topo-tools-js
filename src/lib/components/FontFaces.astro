---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<style
  is:inline
  set:html={`@font-face{font-family:Merriweather;font-weight:700;font-display:swap;src:url(${base}fonts/merriweather-700.woff2) format("woff2")}@font-face{font-family:Roboto;font-weight:400 700;font-display:swap;src:url(${base}fonts/roboto.woff2) format("woff2")}`}
/>
