---
import type { Tool } from "$lib/tools";

interface Props {
  tool: Tool;
  variant?: "primary" | "secondary" | "tertiary";
  header?: boolean;
}

const { tool, variant = "primary", header = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<a class={`card ${variant} ${header ? "header" : ""}`} href={`${base}${tool.slug}`}>
  <img class="icon" src={`${base}${tool.iconHref.slice(1)}`} alt="" aria-hidden="true" width="64" height="64" />
  <div class="text">
    <h3 class="name">{tool.name}</h3>
    <p class="tagline">{tool.tagline}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: border-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
  }
  .card:hover {
    border-color: #9ca3af;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.04);
    transform: translateY(-1px);
  }
  .icon {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    color: #1f2937;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }
  .name {
    font-size: 1.05rem;
    font-weight: 600;
    color: #111;
    margin: 0;
  }
  .tagline {
    font-size: 0.875rem;
    color: #4b5563;
    margin: 0;
    line-height: 1.45;
  }

  .card.secondary,
  .card.tertiary {
    gap: 0.75rem;
  }
  .card.secondary .text,
  .card.tertiary .text {
    gap: 0.2rem;
  }
  .card.secondary {
    padding: 0.875rem;
  }
  .card.secondary .icon {
    width: 36px;
    height: 36px;
  }
  .card.secondary .name {
    font-size: 0.925rem;
  }
  .card.secondary .tagline {
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .card.tertiary {
    padding: 0.625rem;
  }
  .card.tertiary .icon {
    width: 26px;
    height: 26px;
  }
  .card.tertiary .name {
    font-size: 0.825rem;
  }
  .card.tertiary .tagline {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .card.header {
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
  }
  .card.header:hover {
    box-shadow: none;
    transform: none;
  }
</style>
