---
interface Props {
  nested?: boolean;
}

const { nested = false } = Astro.props;
---

<div class={`group ${nested ? "nested" : ""}`}>
  <slot />
</div>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 10px rgba(0, 0, 0, 0.025);
    transition: border-color 120ms ease, box-shadow 120ms ease, transform 120ms ease;
  }
  .group.nested {
    padding: 0.875rem;
  }
  :global(.group:has(> .card.header:hover)) {
    border-color: #9ca3af;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 12px rgba(0, 0, 0, 0.04);
    transform: translateY(-1px);
  }
</style>
