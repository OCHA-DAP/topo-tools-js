---
interface Props {
  nested?: boolean;
}

const { nested = false } = Astro.props;
---

<div class={`group ${nested ? "nested" : ""}`}>
  <slot />
</div>

<style>
  .group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--hdx-neutral-1);
    border-radius: var(--hdx-radius-sm);
    background: var(--hdx-neutral-0);
    box-shadow: var(--hdx-shadow-sm);
    transition: border-color 0.15s ease;
  }
  .group.nested {
    padding: 0.875rem;
  }
  :global(.group:has(> .card.header:hover)) {
    border-color: var(--hdx-neutral-8);
  }
</style>
