---
interface Props {
  to: string;
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = base + Astro.props.to;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={href} />
    <script
      is:inline
      set:html={`location.replace(${JSON.stringify(href)} + location.search + location.hash);`}
    />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <title>Redirecting…</title>
  </head>
  <body>
    <a href={href}>Continue to {href}</a>
  </body>
</html>
