---
import OfflineToggle from "$lib/components/OfflineToggle.svelte";
import ToolCard from "$lib/components/ToolCard.astro";
import GroupBox from "$lib/components/GroupBox.astro";
import Step from "$lib/components/Step.astro";
import { tools } from "$lib/tools";
import Layout from "../layouts/Layout.astro";

const bySlug = (slug: string) => tools.find((t) => t.slug === slug)!;
const clean = bySlug("clean");
const detect = bySlug("detect");
const match = bySlug("match");
const extend = bySlug("extend");
const mosaic = bySlug("mosaic");
const clip = bySlug("clip");
const stitch = bySlug("stitch");
const change = bySlug("change");
const pkg = bySlug("package");
const packagePolygons = bySlug("package-polygons");
const packagePoints = bySlug("package-points");
const packageLines = bySlug("package-lines");
const schemaCrosswalk = bySlug("schema-crosswalk");
const schemaMap = bySlug("schema-map");
const schemaRefactor = bySlug("schema-refactor");
const schemaFill = bySlug("schema-fill");
const codeRefactor = bySlug("code-refactor");
const codeUpdate = bySlug("code-update");
---

<Layout
  title="Topology Tools: browser-only geospatial utilities"
  description="A suite of browser-only geospatial topology tools. All processing runs client-side; your files never leave your device."
>
  <main class="page">
    <header class="hero">
      <h1>Topology Tools</h1>
      <p class="tagline">
        Take a raw administrative boundary delivery through to a clean, coded, packaged release,
        one step at a time. All processing runs in your browser via WebAssembly, so your files never
        leave your device.
      </p>
    </header>

    <section class="tools">
      <h2 class="section-heading">COD-AB cleaning</h2>
      <ol class="steps">
        <Step n={1} title="Schema" summary="Map source columns to admin code and name columns, then apply the crosswalk.">
          <GroupBox>
            <ToolCard tool={schemaCrosswalk} header />
            <div class="below">
              <ToolCard tool={schemaMap} variant="secondary" />
              <ToolCard tool={schemaRefactor} variant="secondary" />
            </div>
          </GroupBox>
        </Step>

        <Step n={2} title="Topology" summary="Find gaps and overlaps between units, then clean them.">
          <GroupBox>
            <ToolCard tool={clean} header />
            <div class="below">
              <ToolCard tool={detect} variant="secondary" />
            </div>
          </GroupBox>
        </Step>

        <Step n={3} title="Edge matching" summary="Fit units to a reference boundary so the outer edge follows the agreed outline.">
          <GroupBox>
            <ToolCard tool={match} header />
            <div class="below">
              <ToolCard tool={extend} variant="secondary" />
              <GroupBox nested>
                <ToolCard tool={mosaic} variant="secondary" header />
                <div class="below">
                  <ToolCard tool={clip} variant="tertiary" />
                  <ToolCard tool={stitch} variant="tertiary" />
                </div>
              </GroupBox>
            </div>
          </GroupBox>
        </Step>

        <Step n={4} title="Codes" summary="Keep the previous release's codes for units that carry over, or cold-start codes when there is no previous release.">
          <GroupBox>
            <ToolCard tool={codeUpdate} header />
            <div class="below">
              <ToolCard tool={codeRefactor} variant="secondary" />
            </div>
          </GroupBox>
        </Step>

        <Step n={5} title="Names" summary="Review names by hand: duplicates under the same parent, near-duplicate typos, blanks and placeholders, and encoding artifacts." />

        <Step n={6} title="Packaging" summary="Build per-level polygons, label points, and the boundary line network for release." last>
          <GroupBox>
            <ToolCard tool={pkg} header />
            <div class="below">
              <ToolCard tool={packagePolygons} variant="secondary" />
              <ToolCard tool={packagePoints} variant="secondary" />
              <ToolCard tool={packageLines} variant="secondary" />
            </div>
          </GroupBox>
        </Step>
      </ol>
    </section>

    <section class="tools">
      <h2 class="section-heading">Other tools</h2>
      <div class="groups">
        <ToolCard tool={change} />
        <ToolCard tool={schemaFill} />
      </div>
    </section>

    <section class="settings">
      <h2 class="section-heading">Site settings</h2>
      <div class="settings-card">
        <OfflineToggle client:load />
      </div>
    </section>

    <footer class="footer">
      <p>Made by <a href="https://github.com/OCHA-DAP/topo-tools-js">OCHA</a>.</p>
    </footer>
  </main>
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .hero h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .hero .tagline {
    font-size: 1rem;
    color: #4b5563;
    margin: 0;
    line-height: 1.55;
    max-width: 56ch;
  }
  .section-heading {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
  }
  .steps {
    margin: 0;
    padding: 0;
  }
  .groups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .below {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .settings-card {
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
    /* Reserve space so the footer below doesn't shift while the
       OfflineToggle island hydrates (pre-hydration the inner .offline
       div is empty). */
    min-height: 88px;
  }
  .footer {
    border-top: 1px solid #e5e7eb;
    padding-top: 1.25rem;
  }
  .footer p {
    margin: 0;
    font-size: 0.825rem;
    color: #6b7280;
  }
  .footer a {
    color: #374151;
  }
</style>
