---
import OfflineToggle from "$lib/components/OfflineToggle.svelte";
import ToolCard from "$lib/components/ToolCard.astro";
import GroupBox from "$lib/components/GroupBox.astro";
import Step from "$lib/components/Step.astro";
import Disclosure from "$lib/components/Disclosure.astro";
import { tools } from "$lib/tools";
import Layout from "../layouts/Layout.astro";

const bySlug = (slug: string) => tools.find((t) => t.slug === slug)!;
const clean = bySlug("topo-clean");
const detect = bySlug("topo-detect");
const match = bySlug("edge-match");
const extend = bySlug("edge-extend");
const mosaic = bySlug("edge-mosaic");
const clip = bySlug("edge-clip");
const stitch = bySlug("edge-stitch");
const change = bySlug("change");
const pkg = bySlug("package");
const packagePolygons = bySlug("package-polygons");
const packagePoints = bySlug("package-points");
const packageLines = bySlug("package-lines");
const schemaMap = bySlug("schema-map");
const schemaJoin = bySlug("schema-join");
const schemaFill = bySlug("schema-fill");
const codeRefactor = bySlug("code-refactor");
const codeUpdate = bySlug("code-update");
---

<Layout
  title="Topology Tools: browser-only geospatial utilities"
  description="A suite of browser-only geospatial topology tools. All processing runs client-side; your files never leave your device."
>
  <main class="page">
    <nav class="topnav" aria-label="Related sites">
      <a href="https://ocha-dap.github.io/topo-tools-py/">Python &amp; CLI</a>
      <a class="source" href="https://github.com/OCHA-DAP/topo-tools-js" title="Go to repository">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--! Font Awesome Free 7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2026 Fonticons, Inc.--><path fill="currentColor" d="M439.6 236.1 244 40.5c-5.4-5.5-12.8-8.5-20.4-8.5s-15 3-20.4 8.4L162.5 81l51.5 51.5c27.1-9.1 52.7 16.8 43.4 43.7l49.7 49.7c34.2-11.8 61.2 31 35.5 56.7-26.5 26.5-70.2-2.9-56-37.3L240.3 199v121.9c25.3 12.5 22.3 41.8 9.1 55-6.4 6.4-15.2 10.1-24.3 10.1s-17.8-3.6-24.3-10.1c-17.6-17.6-11.1-46.9 11.2-56v-123c-20.8-8.5-24.6-30.7-18.6-45L142.6 101 8.5 235.1C3 240.6 0 247.9 0 255.5s3 15 8.5 20.4l195.6 195.7c5.4 5.4 12.7 8.4 20.4 8.4s15-3 20.4-8.4l194.7-194.7c5.4-5.4 8.4-12.8 8.4-20.4s-3-15-8.4-20.4"/></svg>
        <span>OCHA-DAP/topo-tools-js</span>
      </a>
    </nav>

    <header class="hero">
      <h1>Topology Tools</h1>
      <p class="tagline">
        Take a raw administrative boundary delivery through to a clean, coded, packaged release, one
        step at a time. All processing runs in your browser via WebAssembly, so your files never
        leave your device.
      </p>
    </header>

    <section class="tools">
      <h2 class="section-heading">Boundary cleaning</h2>
      <ol class="steps">
        <Step
          n={1}
          title="Schema"
          summary="Map source columns to admin code and name columns, then apply the crosswalk."
        >
          <GroupBox>
            <ToolCard tool={schemaMap} header />
            <Disclosure label="Show 2 individual tools">
              <ToolCard tool={schemaJoin} variant="secondary" />
              <ToolCard tool={schemaFill} variant="secondary" />
            </Disclosure>
          </GroupBox>
        </Step>

        <Step
          n={2}
          title="Topology"
          summary="Find gaps and overlaps between units, then clean them."
        >
          <GroupBox>
            <ToolCard tool={clean} header />
            <Disclosure label="Show 1 individual tool">
              <ToolCard tool={detect} variant="secondary" />
            </Disclosure>
          </GroupBox>
        </Step>

        <Step
          n={3}
          title="Edge matching"
          summary="Fit units to a reference boundary so the outer edge follows the agreed outline."
        >
          <GroupBox>
            <ToolCard tool={match} header />
            <Disclosure label="Show 2 individual tools">
              <ToolCard tool={extend} variant="secondary" />
              <GroupBox nested>
                <ToolCard tool={mosaic} variant="secondary" header />
                <div class="below">
                  <ToolCard tool={clip} variant="tertiary" />
                  <ToolCard tool={stitch} variant="tertiary" />
                </div>
              </GroupBox>
            </Disclosure>
          </GroupBox>
        </Step>

        <Step
          n={4}
          title="Codes"
          summary="Keep the previous release's codes for units that carry over, or cold-start codes when there is no previous release."
        >
          <GroupBox>
            <ToolCard tool={codeUpdate} header />
            <Disclosure label="Show 2 individual tools">
              <ToolCard tool={codeRefactor} variant="secondary" />
              <ToolCard tool={change} variant="secondary" />
            </Disclosure>
          </GroupBox>
        </Step>

        <Step
          n={5}
          title="Names"
          icon="icons/steps/names.svg"
          summary="Review names by hand: duplicates under the same parent, near-duplicate typos, blanks and placeholders, and encoding artifacts."
        />

        <Step
          n={6}
          title="Packaging"
          summary="Build per-level polygons, label points, and the boundary line network for release."
          last
        >
          <GroupBox>
            <ToolCard tool={pkg} header />
            <Disclosure label="Show 3 individual tools">
              <ToolCard tool={packagePolygons} variant="secondary" />
              <ToolCard tool={packagePoints} variant="secondary" />
              <ToolCard tool={packageLines} variant="secondary" />
            </Disclosure>
          </GroupBox>
        </Step>
      </ol>
    </section>

    <details class="settings">
      <summary><h2 class="section-heading">Site settings</h2></summary>
      <div class="settings-card">
        <OfflineToggle client:load />
      </div>
    </details>
  </main>
</Layout>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .topnav {
    display: flex;
    justify-content: flex-end;
    gap: 1.25rem;
    margin-bottom: -1.5rem;
    font-size: 0.875rem;
  }
  .topnav a {
    color: #4b5563;
    text-decoration: none;
  }
  .topnav a:hover {
    color: #111;
    text-decoration: underline;
  }
  .topnav .source {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .topnav .source:hover {
    text-decoration: none;
  }
  .topnav .source svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  .hero h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #111;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .hero .tagline {
    font-size: 1rem;
    color: #4b5563;
    margin: 0;
    line-height: 1.55;
    max-width: 56ch;
  }
  .section-heading {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.75rem;
  }
  .steps {
    margin: 0;
    padding: 0;
  }
  .below {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .settings > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: #6b7280;
    list-style: none;
    user-select: none;
  }
  .settings > summary::-webkit-details-marker {
    display: none;
  }
  .settings > summary::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 120ms ease;
  }
  .settings[open] > summary::before {
    transform: rotate(45deg);
  }
  .settings > summary .section-heading {
    margin: 0;
  }
  .settings[open] > summary {
    margin-bottom: 0.75rem;
  }
  .settings > summary:hover,
  .settings > summary:hover .section-heading {
    color: #111;
  }
  .settings-card {
    padding: 1rem 1.25rem;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    background: #fff;
  }
</style>
